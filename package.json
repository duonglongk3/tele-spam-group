{
  "name": "telegram-auto-post-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram Auto Post & Management Desktop Tool",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run next:dev\" \"npm run electron:dev\"",
    "next:dev": "next dev --port 3000",
    "next:build": "next build",
    "electron:dev": "wait-on http://localhost:3000 && electron .",
    "electron:build": "set NODE_OPTIONS=--max-old-space-size=8192&& set ELECTRON_BUILD=true&& npm run next:build && electron-builder",
    "build": "npm run electron:build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.69.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.0",
    "electron-store": "^10.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.0.0",
    "lucide-react": "^0.483.0",
    "next": "^15.2.4",
    "node-cron": "^3.0.3",
    "papaparse": "^5.5.2",
    "postcss": "^8.5.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "sonner": "^2.0.1",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.1.0",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.14",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.1.2",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.googleadmintool.app",
    "productName": "Google Admin Tool",
    "extends": null,
    "files": [
      "electron/**/*",
      "out/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  }
}
